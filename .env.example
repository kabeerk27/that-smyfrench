# Environment Variables Template
# Copy this file to .env.local and fill in with your actual values

# Next.js
NODE_ENV=production
NEXT_PUBLIC_SITE_URL=https://thatsmyfrench.com

# API Configuration (if needed later)
# NEXT_PUBLIC_API_URL=https://api.thatsmyfrench.com

# Email Service (optional - for production contact form)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# CONTACT_EMAIL=info@thatsmyfrench.com

# Database (optional - for future enrollment system)
# DATABASE_URL=postgresql://user:password@localhost:5432/thatsmyfrench

# Analytics (optional)
# NEXT_PUBLIC_GA_ID=your-google-analytics-id
